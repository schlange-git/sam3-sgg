digraph TemporalTripletMemoryDetailed {
  graph [rankdir=TB, splines=ortho, nodesep=0.45, ranksep=0.65, pad=0.25, bgcolor="white", fontname="Helvetica"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin="0.10,0.07", color="#333333", penwidth=1.0];
  edge [fontname="Helvetica", fontsize=9, color="#555555", arrowsize=0.7];

  subgraph cluster_input {
    label="Input and single-frame SGG backbone";
    color="#1d4e89"; style="rounded";
    A0 [label="Video mini-batch\nsame-video clip sampling", fillcolor="#f7f7f7"];
    A1 [label="Current frame image I_t", fillcolor="#f7f7f7"];
    A2 [label="Metadata\nvideo_id, frame_idx", fillcolor="#f7f7f7"];
    B0 [label="SAM3 / X-SAM visual backbone\npatch-merge feature extraction", fillcolor="#e8f1ff"];
    B1 [label="Feature map + padding mask\n+ position embedding", fillcolor="#e8f1ff"];
    C0 [label="IterativeRelationTransformer\nencoder + decoder", fillcolor="#e8f1ff"];
    C1 [label="Decoder hidden states\nhs_subject_last\nhs_object_last\nhs_relation_last", fillcolor="#e8f1ff"];
    C2 [label="Initial prediction tensors\nsubject/object/relation logits and boxes", fillcolor="#e8f1ff"];
    A0 -> A1 -> B0 -> B1 -> C0 -> C1 -> C2;
    A0 -> A2;
  }

  subgraph cluster_read {
    label="Per-video triplet memory read";
    color="#b36b00"; style="rounded";
    M0 [label="TripletMemoryManager.get_batch_memory", fillcolor="#fff4df"];
    M1 [label="maybe_clear_on_video_jump\nclear bank if frame_idx regresses", fillcolor="#fff4df"];
    M2 [label="Select / create TripletMemoryBank\nfor current video_id", fillcolor="#fff4df"];
    M3 [label="Collect valid slots\nvalid=True and feat exists", fillcolor="#fff4df"];
    M4 [label="Any valid memory slots?", shape=diamond, fillcolor="#ffffff", margin="0.06,0.04"];
    M5 [label="Skip temporal injection\nkeep original decoder output", fillcolor="#fff4df"];
    M6 [label="Stack slot features\nM x 128", fillcolor="#fff4df"];
    M7 [label="Add delta-time bucket embedding\nΔt = current - slot frame_idx", fillcolor="#fff4df"];
    M8 [label="Score-weight memory features\nfeat = feat * slot_score", fillcolor="#fff4df"];
    M9 [label="Pad batch memory\nmemory: B x M_max x 128\nmask: B x M_max", fillcolor="#fff4df"];
    M0 -> M1 -> M2 -> M3 -> M4;
    M4 -> M5 [label="No"];
    M4 -> M6 [label="Yes"];
    M6 -> M7 -> M8 -> M9;
  }

  subgraph cluster_inject {
    label="Gated cross-attention injection";
    color="#2a7f3f"; style="rounded";
    G0 [label="triplet_iter_counter += 1", fillcolor="#e9f8ee"];
    G1 [label="get_temporal_gate", fillcolor="#e9f8ee"];
    G2 [label="Gate schedule\n0 before 10% max_iter\nlinear warmup 10%-30%\nthen gate_max", fillcolor="#e9f8ee"];
    G3 [label="Object gate max = 0.15\nRelation gate max = 0.30", fillcolor="#e9f8ee"];
    I0 [label="TemporalTripletInjector\nMHA query=current features\nkey/value=memory", fillcolor="#e9f8ee"];
    I1 [label="Object branch injection\nQ_obj* = Q_obj + gate_obj * CrossAttn", fillcolor="#e9f8ee"];
    I2 [label="Relation branch injection\nQ_rel* = Q_rel + gate_rel * CrossAttn", fillcolor="#e9f8ee"];
    I3 [label="Recompute final object logits/boxes\nreplace only last decoder layer", fillcolor="#e9f8ee"];
    I4 [label="Recompute final relation logits/boxes\nreplace only last decoder layer", fillcolor="#e9f8ee"];
    I5 [label="Temporally enhanced output", fillcolor="#e9f8ee"];
    G0 -> G1 -> G2 -> G3 -> I0;
    I0 -> I1 -> I3 -> I5;
    I0 -> I2 -> I4 -> I5;
  }

  subgraph cluster_pred {
    label="Current-frame prediction and objective";
    color="#6f42c1"; style="rounded";
    P0 [label="Optional downstream modules\nROI refine / obj split / aux outputs", fillcolor="#f3e8ff"];
    P1 [label="Assemble final out dict\nrelation boxes/logits\nsubject/object boxes/logits", fillcolor="#f3e8ff"];
    P2 [label="Scene graph losses and evaluation\ncurrent-frame supervision", fillcolor="#f3e8ff"];
    P0 -> P1 -> P2;
  }

  subgraph cluster_candidate {
    label="Memory candidate construction under no_grad";
    color="#b3261e"; style="rounded";
    U0 [label="Triplet memory update block\ntraining or temporal_eval", fillcolor="#fce8e6"];
    U1 [label="Read final outputs\nrelation logits, subject/object logits\nboxes, hs_relation_last", fillcolor="#fce8e6"];
    U2 [label="Compute probabilities\nsoftmax subject/object/relation", fillcolor="#fce8e6"];
    U3 [label="Choose labels and scores\nsub_score, obj_score, pred_score", fillcolor="#fce8e6"];
    U4 [label="Triplet quality\nq = sub_score * obj_score * pred_score", fillcolor="#fce8e6"];
    U5 [label="Top-k selection\nK=16 by default", fillcolor="#fce8e6"];
    U6 [label="Threshold filtering\nq >= 0.10 by default", fillcolor="#fce8e6"];
    U7 [label="Build candidate signature\n(sub_label, pred_label, obj_label)", fillcolor="#fce8e6"];
    U8 [label="Convert boxes\ncxcywh -> xyxy, clamp [0,1]", fillcolor="#fce8e6"];
    U9 [label="Make union box", fillcolor="#fce8e6"];
    U10 [label="TripletMemoryEncoder", fillcolor="#fce8e6"];
    U11 [label="Encode memory feature from\nrelation query + boxes\nrelative geometry + predicate distribution", fillcolor="#fce8e6"];
    U12 [label="Candidate dict\nsignature, feat, boxes, score components", fillcolor="#fce8e6"];
    U0 -> U1 -> U2 -> U3 -> U4 -> U5 -> U6 -> U7 -> U8 -> U9 -> U10 -> U11 -> U12;
  }

  subgraph cluster_write {
    label="Per-video memory write";
    color="#b36b00"; style="rounded";
    W0 [label="TripletMemoryManager.update_batch", fillcolor="#fff4df"];
    W1 [label="For each video bank\nupdate candidates", fillcolor="#fff4df"];
    W2 [label="Find matching slot\nsame signature + mean IoU(sub,obj,union) > 0.3", fillcolor="#fff4df"];
    W3 [label="Matched existing slot?", shape=diamond, fillcolor="#ffffff", margin="0.06,0.04"];
    W4 [label="EMA update\nfeat/boxes momentum=0.9\nscore=max, miss=0, age+=1", fillcolor="#fff4df"];
    W5 [label="Bank has free slot?", shape=diamond, fillcolor="#ffffff", margin="0.06,0.04"];
    W6 [label="Insert new slot", fillcolor="#fff4df"];
    W7 [label="Replace weakest slot\nmin score - 0.05 * miss", fillcolor="#fff4df"];
    W8 [label="Expire unmatched slots", fillcolor="#fff4df"];
    W9 [label="miss += 1 for unmatched\ninvalid if miss > 2", fillcolor="#fff4df"];
    W0 -> W1 -> W2 -> W3;
    W3 -> W4 [label="Yes"];
    W3 -> W5 [label="No"];
    W5 -> W6 [label="Yes"];
    W5 -> W7 [label="No"];
    W4 -> W8;
    W6 -> W8;
    W7 -> W8;
    W8 -> W9;
  }

  A2 -> M0;
  M9 -> I0;
  C1 -> I0;
  C2 -> I5 [style=dashed, label="original output path"];
  M5 -> I5;
  I5 -> P0;
  P1 -> U0;
  U12 -> W0;
  A2 -> W0;
  W9 -> M2 [label="available to later frames", color="#b36b00"];
}
